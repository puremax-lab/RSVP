rules_version = '2';

// Christmas Party II — espace membre (comptes invités + Secret Santa + messagerie privée)
//
// Collections :
//  - guests/{uid}               profil d'un invité connecté (1 doc par compte)
//  - pairs/{pairId}/messages/*  messages entre les deux personnes d'un binôme Secret Santa
//                                (pairId = "uidOffreur_uidReceveur_idTirage" ; anciens tirages :
//                                les deux uid triés et joints par "_"). Les emails
//                                des deux membres ne sont JAMAIS stockés dans Firestore —
//                                ils vivent uniquement côté serveur (Apps Script), pour que
//                                la notification "nouveau message" ne transite jamais par le
//                                navigateur de l'autre personne.
//  - updates/{updateId}         annonces publiées par les organisateurs, visibles par
//                                tous les invités connectés (espace membre)
//
// Admin = Kisha, Max & Esther, identifiés par leur email de connexion (pas de mot de passe
// ni de clé séparée à gérer : Firestore vérifie directement l'email authentifié).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'josepha.tsm@outlook.be',
        'youtamaxime@gmail.com',
        'adjo93@hotmail.fr'
      ];
    }

    function isPairMember(pairId) {
      return isSignedIn() && (
        pairId.split('_')[0] == request.auth.uid ||
        pairId.split('_')[1] == request.auth.uid
      );
    }

    match /guests/{uid} {
      // Un invité peut lire son propre profil, un admin peut tout lire,
      // et la personne qui doit offrir un cadeau à {uid} peut lire son nom
      // (nécessaire pour savoir à qui elle offre — mais pas l'inverse,
      // ce qui garde le "secret" du Secret Santa).
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/guests/$(request.auth.uid)).data.santaForUid == uid
      );

      // Création du profil : uniquement par la personne elle-même, avec son
      // propre email authentifié, et seulement les champs attendus (pas de
      // santaForUid auto-assigné). wantsSanta démarre à false : le choix de
      // participer ou non au Secret Santa se fait dans la pop-up de bienvenue,
      // juste après la création du compte (onboarded passe alors à true).
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'wantsSanta', 'onboarded'])
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.wantsSanta == false
                    && request.resource.data.onboarded == false;

      // Mise à jour : l'invité peut changer son propre nom, son choix de
      // participation au Secret Santa (il peut changer d'avis avant le tirage),
      // répondre à la pop-up de bienvenue (onboarded), et marquer les annonces /
      // messages comme vus (lastSeenUpdatesAt, givingLastSeenAt,
      // receivingLastSeenAt — utilisés uniquement pour afficher un badge "nouveau"
      // côté client, aucune donnée sensible). Le tirage au sort (santaForUid /
      // receivingThreadId) n'est modifiable que par un admin.
      // Une fois le tirage fait (binôme attribué), l'invité ne peut plus
      // modifier sa participation : se retirer casserait la chaîne des binômes.
      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'wantsSanta', 'onboarded', 'lastSeenUpdatesAt', 'givingLastSeenAt', 'receivingLastSeenAt'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['wantsSanta'])
                            || !('santaForUid' in resource.data)));

      allow delete: if isAdmin();
    }

    match /updates/{updateId} {
      // Toute personne connectée (invité ou admin) peut lire les annonces.
      // Seuls les admins peuvent en publier ou en supprimer.
      allow read: if isSignedIn();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(['title', 'body', 'createdAt'])
                    && request.resource.data.title is string && request.resource.data.title.size() > 0
                    && request.resource.data.body is string && request.resource.data.body.size() > 0;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /pairs/{pairId}/messages/{messageId} {
      // Seules les deux personnes du binôme peuvent lire ou écrire —
      // même les admins n'y ont pas accès, c'est strictement privé.
      allow read: if isPairMember(pairId);
      allow create: if isPairMember(pairId)
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 2000;
      allow update, delete: if false;
    }

    // Tout le reste est fermé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
